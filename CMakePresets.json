{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 24,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "editor",
            "displayName": "Editor Debug",
            "inherits": "debug",
            "binaryDir": "${sourceDir}/build/editor",
            "cacheVariables": { "TEYA_ENABLE_EDITOR": "ON", "TEYA_GAME_EDITOR_BUILD_TESTS": "ON" }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/debug",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            },
            "warnings": {
                "deprecated": false
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "windows-editor",
            "displayName": "Windows Editor (Visual Studio)",
            "inherits": "windows-debug",
            "binaryDir": "${sourceDir}/build/windows-editor",
            "cacheVariables": { "TEYA_ENABLE_EDITOR": "ON", "TEYA_GAME_EDITOR_BUILD_TESTS": "ON" }
        },
        {
            "name": "release",
            "displayName": "Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/release",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            },
            "warnings": {
                "deprecated": false
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "profile",
            "displayName": "Profile (Tracy)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/profile",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            },
            "warnings": {
                "deprecated": false
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "TEYA_ENABLE_PROFILING": "ON"
            }
        },
        {
            "name": "windows-debug",
            "displayName": "Windows Debug (Visual Studio)",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/windows-debug",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-release",
            "displayName": "Windows Release (Visual Studio)",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/windows-release",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-profile",
            "displayName": "Windows Profile (Visual Studio)",
            "inherits": "windows-release",
            "binaryDir": "${sourceDir}/build/windows-profile",
            "cacheVariables": { "TEYA_ENABLE_PROFILING": "ON", "TEYA_ENABLE_EDITOR": "OFF" }
        }
    ],
    "buildPresets": [
        { "name": "editor", "configurePreset": "editor" },
        { "name": "windows-editor", "configurePreset": "windows-editor", "configuration": "Debug" },
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "profile",
            "configurePreset": "profile"
        },
        {
            "name": "windows-debug",
            "configurePreset": "windows-debug",
            "configuration": "Debug"
        },
        {
            "name": "windows-release",
            "configurePreset": "windows-release",
            "configuration": "Release"
        },
        {
            "name": "windows-profile",
            "configurePreset": "windows-profile",
            "configuration": "RelWithDebInfo"
        }
    ]
}
